DATABASE_URL=postgresql+psycopg://schoolcrm:schoolcrm@localhost:5432/schoolcrm
MIGRATION_DATABASE_URL=postgresql+psycopg://schoolcrm:schoolcrm@localhost:5432/schoolcrm
ENVIRONMENT=production
AUTH_REQUIRED=true
STRICT_RBAC=true
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_SECRET=replace-with-a-private-first-run-key
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=https://crm.example.com
FRONTEND_URL=https://crm.example.com
PUBLIC_INTAKE_WINDOW_MINUTES=10
PUBLIC_INTAKE_IP_LIMIT=20
PUBLIC_INTAKE_PHONE_LIMIT=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_EMAIL_LIMIT=10
READ_ONLY_MODE=false
TRANSACTIONAL_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=crm@example.com
SMTP_STARTTLS=true

# Shared only by the production API and the scheduled maintenance caller.
# Use a random value of at least 32 characters. Never commit the real value.
MAINTENANCE_SECRET=
